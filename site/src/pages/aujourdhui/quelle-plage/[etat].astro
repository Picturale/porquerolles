---
import Layout from '../../../layouts/Layout.astro';
import {
  ETATS,
  ETAT_LABELS,
  CONFIANCE_LABELS,
  AXE_LABELS,
  getPlages,
  scoreDuJour,
  getConstatEtat,
} from '../../../lib/lieux.js';
import { u } from '../../../lib/url.js';

export function getStaticPaths() {
  return ETATS.map((etat) => ({ params: { etat: etat.replace('_', '-') }, props: { etat } }));
}

const { etat } = Astro.props;

// Seuils provisoires, pas encore une décision produit actée (voir
// conception/DECISIONS.md §5 pour le vocabulaire à trois niveaux — les
// bornes numériques ci-dessous sont une proposition de cette maquette,
// à confirmer avant toute mise en production).
//
// « à faire aujourd'hui » n'apparaît volontairement jamais ici : §5 dit
// explicitement que ce cran « exige un humain » et que « le moteur [...]
// ne peut jamais le monter » — trouvé et corrigé après une revue croisée
// du 3 août 2026 (le moteur seul l'affichait avant cette correction). Le
// moteur ne peut donc que descendre vers « à éviter » ou rester à
// « correct » ; la couleur reste un dégradé continu (verte pour une bonne
// note), le mot ne franchit jamais la ligne réservée à un humain.
function niveau(min) {
  if (min <= 1) return { mot: 'à éviter aujourd’hui', couleur: '#b23b3b' };
  if (min >= 4) return { mot: 'correct — pas encore validé à la main', couleur: '#2f6b4f' };
  return { mot: 'correct', couleur: '#b8862e' };
}

const plages = getPlages()
  .map((lieu) => ({ lieu, score: scoreDuJour(lieu, etat) }))
  .filter((p) => p.score !== null)
  .sort((a, b) => b.score.min - a.score.min);

const meilleure = plages[0];

// Constat = le champ constat d'etats.yml, pas le dit du lieu — voir le
// commentaire de getConstatEtat() dans lib/lieux.js. "calme" n'a pas de
// texte écrit dans etats.yml : on le dit plutôt que d'improviser une
// phrase à sa place.
const constatEtat = getConstatEtat(etat);
---

<Layout title={`Quelle plage — ${ETAT_LABELS[etat]}`}>
  <h1>Quelle plage aujourd’hui ?</h1>

  <nav class="etat-nav" aria-label="Choisir l'état du jour">
    {
      ETATS.map((e) => (
        <a href={u(`/aujourdhui/quelle-plage/${e.replace('_', '-')}/`)} aria-current={e === etat ? 'true' : 'false'}>
          {ETAT_LABELS[e]}
        </a>
      ))
    }
  </nav>

  {
    meilleure && (
      <div class="constat">
        <p class="label">Constat — {ETAT_LABELS[etat]}</p>
        <p>
          {constatEtat ?? `Aucun texte de constat écrit pour l’état « ${ETAT_LABELS[etat]} » dans etats.yml.`}
        </p>
        <p class="source">
          Source : <code>etats.yml</code>, état nommé — pas encore une mesure horodatée
          (le connecteur vent/mer en direct n’est pas branché, voir <code>A-VERIFIER.md</code>).
        </p>

        <p class="conseil-label label">Conseil — {meilleure.lieu.nom}</p>
        <p>
          {meilleure.lieu.dit?.[etat] && <>« {meilleure.lieu.dit[etat]} » </>}
          {meilleure.score.min >= 4
            ? `${meilleure.lieu.nom} a la meilleure note aujourd’hui sur les données seules — pas encore un « à faire aujourd’hui » validé à la main (DECISIONS.md §5).`
            : meilleure.score.min >= 2
              ? `${meilleure.lieu.nom} reste la meilleure option, sans être idéale.`
              : `Aucune plage n’est vraiment recommandable aujourd’hui — la moins mauvaise est ${meilleure.lieu.nom}.`}
          {' '}Raison : {AXE_LABELS[meilleure.score.raisonAxe]} à {meilleure.score.notes[meilleure.score.raisonAxe]}/5.
        </p>
        <p class="source">
          Confiance de la donnée : {meilleure.lieu.confiance}
          {meilleure.lieu.confiance === 'terrain' ? ' (un relevé sur place l’emporte toujours sur le calcul)' : ''}.
        </p>
      </div>
    )
  }

  <ul class="plages">
    {
      plages.map(({ lieu, score }) => {
        const niv = niveau(score.min);
        return (
          <li class="plage">
            <span class="score-badge" style={`background:${niv.couleur}`} title={niv.mot}>
              {score.min}
            </span>
            <div>
              <div class="nom">
                {lieu.nom}
                <span class={`confiance-tag ${lieu.confiance !== 'terrain' ? 'faible' : ''}`}>
                  {lieu.confiance}
                </span>
              </div>
              <div class="raison">
                {niv.mot} — {AXE_LABELS[score.raisonAxe]} au plus bas ({score.notes[score.raisonAxe]}/5)
                {lieu.remarque ? ` · ${lieu.remarque}` : ''}
              </div>
            </div>
            {/*
              DECISIONS.md §4 : "le produit ne montre jamais ses critères [...]
              les autres axes restent dépliables" — repéré et corrigé après
              une revue croisée du 3 août 2026 (les trois notes étaient
              affichées en permanence avant cette correction). <details>
              natif, sans JS.
            */}
            <details class="axes">
              <summary>détail des trois notes</summary>
              eau {score.notes.eau} · sable {score.notes.sable} · tranq. {score.notes.tranquillite}
            </details>
          </li>
        );
      })
    }
  </ul>

  {
    plages.length === 0 && (
      <p>Aucune donnée pour cet état — {ETAT_LABELS[etat]} n’est pas encore documenté dans lieux.yml.</p>
    )
  }
</Layout>

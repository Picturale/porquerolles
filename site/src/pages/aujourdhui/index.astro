---
import Layout from '../../layouts/Layout.astro';
import { getEtatDuJour, ETATS, ETAT_LABELS } from '../../lib/lieux.js';
import { evaluerFraicheur, formaterAge, STATUT_LABELS } from '../../lib/fraicheur.js';
import { u } from '../../lib/url.js';

const relevé = getEtatDuJour();
// Âge recalculé au build (PLAN A3) — pas le statut figé dans le JSON.
const fraicheur = evaluerFraicheur(relevé);
const ageAffiche = formaterAge(fraicheur.age_minutes);

const aUnePage = relevé && ETATS.includes(relevé.etat.id);
const routeEtat = relevé ? relevé.etat.id.replace(/_/g, '-') : null;
---

<Layout title="Aujourd’hui">
  <h1>Aujourd’hui</h1>

  {
    !relevé && (
      <p>
        Le connecteur vent (<code>moteur/connecteurs/vent.py</code>) n’a jamais tourné dans
        cet environnement. Rien à afficher — pas de valeur inventée.
      </p>
    )
  }

  {
    relevé && (
      <div class:list={['constat', { structurel: fraicheur.structurel }]}>
        <p class="label">Relevé de vent</p>
        <p>
          {relevé.observation.direction_deg}° à {relevé.observation.vitesse_nds} nds
          (rafales {relevé.observation.rafales_nds} nds).
        </p>
        <p class="source">
          Mesuré à {relevé.observation.mesure_a} (heure locale) · cache écrit le{' '}
          {new Date(relevé.genere_le).toLocaleString('fr-FR', { timeZone: 'Europe/Paris' })} ·{' '}
          <span style={`color:${STATUT_LABELS[fraicheur.statut].couleur};font-weight:600;`}>
            {STATUT_LABELS[fraicheur.statut].mot}
          </span>
          {ageAffiche && <> ({ageAffiche})</>} · source :{' '}
          <a href={relevé.observation.url}>{relevé.observation.source}</a>.
        </p>

        {
          fraicheur.structurel && (
            <p class="structurel-alerte">
              Donnée structurelle — le cache a plus de 4× sa validité (
              {relevé.observation.validite_minutes} min). Affichée grisée et datée, pas
              masquée. Va vérifier la source officielle :{' '}
              <a href={relevé.observation.url}>ouvrir le relevé →</a>
            </p>
          )
        }

        <p class="source">
          Instantané lu au build du site (statique, DECISIONS.md §9). L’âge ci-dessus est
          calculé au moment de la construction ; le cron horaire
          (<code>refresh.yml</code>) rend cette approximation acceptable.
        </p>

        <p class="conseil-label label">État calculé — {relevé.etat.nom}</p>
        <p>
          {relevé.etat.constat ??
            `Aucun texte de constat écrit pour l’état « ${relevé.etat.nom} » dans etats.yml.`}
        </p>

        {relevé.veto_vent_extreme_actif && (
          <p class="source" style="color:#b23b3b;font-weight:600;">
            Veto vent extrême actif : sable forcé à {relevé.veto_vent_extreme_detail.note}/5 sur
            tous les lieux, quel que soit l’abri — {relevé.veto_vent_extreme_detail.dit}.
          </p>
        )}

        {aUnePage ? (
          <p>
            <a href={u(`/aujourdhui/quelle-plage/${routeEtat}/`)}>
              Voir la matrice des plages pour cet état →
            </a>
          </p>
        ) : (
          <p class="source">
            Pas encore de matrice de plages pour «&nbsp;{relevé.etat.nom}&nbsp;» — le site n’a
            de notes complètes que pour {ETATS.map((e) => ETAT_LABELS[e]).join(', ')}. Voir{' '}
            <code>REVUE-CRITIQUE-KIMI.md</code> (constat A8).
          </p>
        )}
      </div>
    )
  }

  <nav class="etat-nav">
    <a href={u('/aujourdhui/quelle-plage/')}>Choisir un état manuellement</a>
    <a href={u('/aujourdhui/feu/')}>Risque incendie</a>
    <a href={u('/carte/')}>Carte</a>
  </nav>
</Layout>

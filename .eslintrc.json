{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "settings": {
    "react": { "version": "detect" }
  },
  "ignorePatterns": [
    "dist/**",
    "src/core-app/**",
    "src/social-app/backend/**"
  ],
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
  "no-console": ["warn", { "allow": ["warn", "error"] }],
  "no-empty": ["warn", { "allowEmptyCatch": true }]
  },
  "overrides": [
    {
      "files": ["dist/assets/*.js"],
      "rules": {
        "no-undef": "off",
        "no-console": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "env": {
        "node": true,
        "es2021": true
      },
      "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
      },
      "rules": {
        "no-console": "off",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint", "react", "react-hooks"],
      "extends": [
        "plugin:@typescript-eslint/recommended",
        "plugin:react/recommended"
      ],
      "parserOptions": {
        "ecmaFeatures": { "jsx": true },
        "sourceType": "module"
      },
      "rules": {
        "indent": "off",
        "react/react-in-jsx-scope": "off",
        "react/no-unescaped-entities": "off",
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
      }
    }
  ]
}

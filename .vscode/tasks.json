			]
		},
		{
			"label": "safe-repo-cleanup",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"set -e\n# Show initial size\nprintf \"Initial size: \"; du -sh . | awk '{print $1}'\n\n# Remove generated build artifacts and emulator data\nrm -rf dist .emulator-data firebase-debug.log* storage_export firestore_export\n\n# Remove platform build outputs & caches (regenerable)\nrm -rf android/build android/app/build android/.gradle android/.idea android/capacitor-cordova-android-plugins\nrm -rf ios/build ios/App/Pods ios/capacitor-cordova-ios-plugins ios/App/Podfile.lock\n\n# Remove test/coverage reports\nrm -rf coverage playwright-report test-results .nyc_output\n\n# Remove large deployment logs and backups\nrm -f DEPLOYMENT-LOG-*.md BUILD-REPORT.md CLEANUP-*.md\nrm -f CreatePost_backup.jsx RichTextEditor_backup.jsx\n\n# Optional: prune leftover archives\nfind . -maxdepth 2 -type f \\( -name \"*.tar\" -o -name \"*.tar.gz\" -o -name \"*.zip\" -o -name \"*.tgz\" \\) -print -delete || true\n\n# Show final size\nprintf \"Final size:   \"; du -sh . | awk '{print $1}'\n"
			]
		},
		{
			"label": "deploy-firestore-only",

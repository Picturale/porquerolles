{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"command": "npm run build",
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Deploy Validated",
			"type": "shell",
			"command": "npm run deploy:validated",
			"group": "build",
			"isBackground": false,
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "Validate Build",
			"type": "shell",
			"command": "npm run validate",
			"group": "test",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "iOS Build",
			"type": "shell",
			"command": "npm run ios",
			"group": "build",
			"isBackground": false
		},
		{

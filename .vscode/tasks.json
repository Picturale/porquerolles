		{
			"label": "export-firestore-indexes",
			"type": "shell",
			"command": "firebase",
			"args": [
				"firestore:indexes",
				"--project",
				"vision-picturale-community",
				"--format",
				"json"
			]
		},
		{
			"label": "sync-firestore-indexes",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"cp config/firestore.indexes.json config/firestore.indexes.backup.json 2>/dev/null || true; firebase firestore:indexes --project vision-picturale-community --format json > config/firestore.indexes.json && echo 'INDEX_EXPORT_DONE'"
			]
		},
		{
			"label": "export-firestore-indexes-raw",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"firebase firestore:indexes --project vision-picturale-community > config/firestore.indexes.json && echo 'INDEX_EXPORT_DONE'"
			]
		},
